{
  "name": "grief-companion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A compassionate AI avatar for processing grief and loss.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run start -w server\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "node --test server/observatory/observatory.test.js",
    "seed:observatory": "node server/observatory/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pptxgenjs": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
